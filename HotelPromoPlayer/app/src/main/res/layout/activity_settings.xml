<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#101010"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:layout_marginBottom="40dp" />

    <!-- Shown only while an automatic first-install download is running -->
    <ProgressBar
        android:id="@+id/progressDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Download progress text, or an error message if it failed -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/buttonRetryDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/retry_download"
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonSelectFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_file"
        android:textSize="18sp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_marginBottom="32dp" />

    <CheckBox
        android:id="@+id/checkboxLaunchOnBoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/launch_on_boot"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
